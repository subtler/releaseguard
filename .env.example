RELEASEGUARD_ENVIRONMENT=development
RELEASEGUARD_LOG_LEVEL=INFO
RELEASEGUARD_TRACE_EXPORTER=none
RELEASEGUARD_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
RELEASEGUARD_EMBEDDING_PROVIDER=hashing
RELEASEGUARD_OLLAMA_BASE_URL=http://127.0.0.1:11434
RELEASEGUARD_OLLAMA_EMBEDDING_MODEL=embeddinggemma
RELEASEGUARD_REPOSITORY_ROOT=.
RELEASEGUARD_CHECKPOINT_DATABASE=.releaseguard/checkpoints.sqlite3
RELEASEGUARD_MAX_DIFF_BYTES=1000000
RELEASEGUARD_MAX_INDEX_FILES=5000
RELEASEGUARD_MAX_SOURCE_FILE_BYTES=250000
RELEASEGUARD_RETRIEVAL_MAX_DOCUMENTS=500
RELEASEGUARD_RETRIEVAL_MAX_FILE_BYTES=20000
RELEASEGUARD_RETRIEVAL_TOP_K=8
